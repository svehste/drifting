# Copy to .env.local and fill in. All values are SERVER-ONLY secrets:
# never prefix DB/service keys with NEXT_PUBLIC_ — the browser must never see them.

# --- Supabase Postgres (Drizzle connects directly over this) ---
# Use the "Session" pooler connection string from Supabase → Project Settings → Database.
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"

# --- Supabase Auth (staff login) ---
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="ey..."         # safe to expose; RLS-independent anon key
SUPABASE_SERVICE_ROLE_KEY="ey..."             # SERVER ONLY. Used for admin invite flow.
